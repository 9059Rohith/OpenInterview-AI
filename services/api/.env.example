# Local: SQLite. Production: APP_ENV=production, PostgreSQL and secure HTTPS cookies.
APP_MODE=local
DATABASE_URL=sqlite:///./openinterview.db
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
AUTO_MIGRATE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Server-owned inference credentials only. Never place user BYOK here.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
COMPATIBLE_API_BASE=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
ENABLE_SERVER_OLLAMA=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
TRANSCRIPTION_MODEL=whisper-1
HEADSHOT_MODEL=gpt-image-1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PLUS_INR=
RAZORPAY_PLAN_PRO_INR=
RAZORPAY_PLAN_PLUS_USD=
RAZORPAY_PLAN_PRO_USD=
PRICE_PLUS_INR=9900
PRICE_PRO_INR=19900
PRICE_PLUS_USD=199
PRICE_PRO_USD=399
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
