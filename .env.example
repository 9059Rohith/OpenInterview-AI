# Optional cloud API. Empty means local-only guest storage in the web app.
NEXT_PUBLIC_API_URL=
# Backend: PostgreSQL for cloud or SQLite for local desktop.
DATABASE_URL=sqlite:///./openinterview.db
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Server-owned inference only. Personal BYOK keys never belong in this file.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
COMPATIBLE_API_KEY=
COMPATIBLE_API_BASE=
COMPATIBLE_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PLUS_INR=
RAZORPAY_PLAN_PLUS_USD=
RAZORPAY_PLAN_PRO_INR=
RAZORPAY_PLAN_PRO_USD=
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
HEADSHOT_MODEL=gpt-image-1
TRANSCRIPTION_MODEL=whisper-1
# Optional server image operations use the server-owned OPENAI_API_KEY above.
# Desktop trusted compatible endpoint (personal key remains in the OS vault).
OPENINTERVIEW_COMPATIBLE_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
